{
  "name": "sg-typer-studio",
  "productName": "SG Typer Studio",
  "version": "0.1.3",
  "description": "A Windows desktop workspace for manga and comics typesetters.",
  "author": "Syndicate",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "content": "node scripts/build-content.js",
    "start": "npm run content && node scripts/start.js",
    "test": "npm run content && node scripts/test-e2e.js",
    "dist": "npm run content && electron-builder --win --x64",
    "dist:win": "npm run content && electron-builder --win --x64",
    "configure:github": "node scripts/configure-github.js",
    "test:unit": "node --test scripts/test-content.js scripts/test-curves.js scripts/test-healing.js scripts/test-navigation.js scripts/test-brushes.js scripts/test-styles-smudge.js scripts/test-actions.js scripts/test-integrations.js scripts/test-updates.js scripts/test-firefly.js scripts/test-firefly-credits.js scripts/test-generative-levels.js scripts/test-profile-migration.js"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "^26.0.12",
    "playwright-core": "^1.56.0"
  },
  "build": {
    "appId": "com.syndicate.sg-typer-studio",
    "productName": "SG Typer Studio",
    "copyright": "Syndicate",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**",
      "content/**",
      "package.json"
    ],
    "asar": true,
    "compression": "maximum",
    "npmRebuild": false,
    "protocols": [
      {
        "name": "SG Typer Studio",
        "schemes": [
          "sg-typer-studio",
          "typer-studio"
        ]
      }
    ],
    "electronLanguages": [
      "en",
      "en-US",
      "fr",
      "es",
      "it",
      "de",
      "pt-BR",
      "ru",
      "uk",
      "pl",
      "nl",
      "tr",
      "ar",
      "vi",
      "id",
      "th",
      "ja",
      "ko",
      "zh-CN"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh",
      "differentialPackage": false,
      "artifactName": "SG Typer Studio-Setup.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Karpenator",
        "repo": "Syndicate_Typer_Studio",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
